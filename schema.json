{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShareTemp resources manifest",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "마지막 수정일 (YYYY-MM-DD)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "anyOf": [{ "required": ["file"] }, { "required": ["url"] }],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "description": "자료 제목" },
          "description": { "type": "string", "description": "한 줄 설명" },
          "category": { "type": "string", "description": "분류. 생략 시 기타" },
          "file": {
            "type": "string",
            "pattern": "^files/.+",
            "description": "레포 기준 상대 경로"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://",
            "description": "외부 링크 주소"
          }
        }
      }
    }
  }
}
